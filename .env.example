PORT=3000
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth — required. The app refuses to start without JWT_SECRET.
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# bcrypt cost factor for password hashing (4-15, default 12)
BCRYPT_COST=12

# Max file upload size in bytes (default 10485760 = 10 MiB). Uploads are
# buffered in memory before sending to R2 — raise with available memory
# and expected concurrency in mind.
FILE_UPLOAD_MAX_BYTES=
