PORT=3000
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth — required. The app refuses to start without JWT_SECRET.
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# bcrypt cost factor for password hashing (4-15, default 12)
BCRYPT_COST=12

# Mobile magic-link auth (Platform: Mobile). The app refuses to start without MOBILE_JWT_SECRET.
MOBILE_JWT_SECRET=
# Unset means mobile JWTs never expire.
MOBILE_JWT_EXPIRES_IN=
# Page the emailed login link opens, with ?token=... appended (default https://mobile.organic-ministry.org/auth)
MOBILE_LOGIN_LINK_URL=
# Resend API key; login returns 500 without it.
RESEND_API_KEY=
# Sender on a Resend-verified domain. The default onboarding@resend.dev only
# delivers to the Resend account owner's address.
MAIL_FROM=
# Where /v1/auth/verify redirects the app (default ommobileapp://auth)
APP_DEEP_LINK_SCHEME=
# true shows the JWT in an HTML page instead of redirecting to the app
AUTH_DEBUG_MODE=false

# Max file upload size in bytes (default 1073741824 = 1 GiB). Direct uploads
# (POST /v1/files/upload-url) never touch API memory; the legacy POST /v1/files
# buffers the whole file in memory, so size it with concurrency in mind.
FILE_UPLOAD_MAX_BYTES=

# OneSignal push (POST /v1/notifications). The app refuses to start without both.
# Dashboard → Settings → Keys & IDs. The API key is server-only; never ship it to a client.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
